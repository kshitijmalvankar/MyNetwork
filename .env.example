# Copy to .env.local with `pnpm setup:env` (generates the app secrets for you).
# Never commit real values. In production these live in Vercel environment variables.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys / Data API) ------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses row-level security; used for keys, audit log and admin tasks.
SUPABASE_SECRET_KEY=
# Database password, used by the Supabase CLI for migrations.
SUPABASE_DB_PASSWORD=
# Session-mode pooler host (Project Settings → Database → Connection string)
SUPABASE_DB_HOST=

# --- Encryption (generated; back up the production values somewhere safe) -----
# 32 random bytes, base64. Wraps every user's data key. Losing it = losing all encrypted data.
APP_MASTER_KEY=
APP_MASTER_KEY_VERSION=1
# 32 random bytes, base64. HMAC key for searchable email/phone fingerprints.
APP_BLIND_INDEX_KEY=

# --- Background jobs ----------------------------------------------------------
CRON_SECRET=

# --- Bot protection (Cloudflare Turnstile) -------------------------------------
# The defaults below are Cloudflare's public always-pass test keys. Replace for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- AI (OpenRouter) ----------------------------------------------------------
OPENROUTER_API_KEY=
# live | mock (mock replays recorded responses; used by end-to-end tests)
AI_MODE=live
# Free-tier AI is paused for the day once total spend crosses this (USD).
AI_GLOBAL_DAILY_USD=5
# Optional model overrides (defaults live in lib/ai/models.ts and are chosen by `pnpm eval`).
# Changing EMBEDDING_MODEL requires `pnpm reindex`.
# VISION_MODEL=
# VISION_MODEL_STRONG=
# CHAT_MODEL=
# EMBEDDING_MODEL=
# VOICE_MODEL=
# VOICE_REASONING=none

# --- Rate limiting (Upstash Redis; optional locally, required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
